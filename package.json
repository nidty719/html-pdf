{
  "name": "html-to-pdf",
  "version": "1.0.0",
  "description": "A Google Cloud Function that converts HTML content to PDF",
  "main": "index.js",
  "scripts": {
    "start": "functions-framework --target=htmlToPdf",
    "dev": "nodemon --exec functions-framework --target=htmlToPdf",
    "deploy": "gcloud functions deploy htmlToPdf --runtime nodejs16 --trigger-http --allow-unauthenticated",
    "test": "mocha tests/**/*.test.js",
    "test:unit": "mocha tests/unit/**/*.test.js",
    "test:integration": "mocha tests/integration/**/*.test.js"
  },
  "keywords": [
    "html",
    "pdf",
    "conversion",
    "puppeteer",
    "cloud-function"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/functions-framework": "^3.1.0",
    "cors": "^2.8.5",
    "helmet": "^6.0.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "puppeteer": "^19.7.2"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "mocha": "^10.2.0",
    "nodemon": "^2.0.20",
    "sinon": "^15.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}